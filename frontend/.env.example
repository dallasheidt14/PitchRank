# PitchRank Frontend Environment Variables Example
# Copy this file to .env.local in THIS directory (frontend/).
# Next.js loads env files from its own project root, so the repository-root
# .env is not read by any frontend command.

# ============================================
# Supabase (required - the app throws without these)
# ============================================
# Read by lib/supabase/client.ts and lib/supabase/server.ts, which throw on
# startup if either is missing.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only, used by API routes that bypass RLS. Never expose this to
# the browser: anything prefixed NEXT_PUBLIC_ is bundled into client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# Site
# ============================================
# Used for SEO metadata, sitemaps, and canonical URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret checked by app/api/process-missing-games before draining the
# scrape queue
CRON_SECRET=your-cron-secret-here

# ============================================
# Payments (Stripe)
# ============================================
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=price_your_monthly_price_id
NEXT_PUBLIC_STRIPE_PRICE_YEARLY=price_your_yearly_price_id

# ============================================
# Email
# ============================================
RESEND_API_KEY=your-resend-api-key

# ============================================
# Analytics (optional - leave empty to disable)
# ============================================
NEXT_PUBLIC_GA_MEASUREMENT_ID=
