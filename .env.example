# PitchRank Environment Variables Example
# Copy this file to .env and fill in your values

# ============================================
# Database Configuration
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
USE_LOCAL_SUPABASE=false
# Direct Postgres connection, used by migration and reporting scripts. Times out
# from dev machines — set it in CI, or locally only if yours can connect.
# DATABASE_URL=postgresql://user:password@host:5432/postgres

# ============================================
# Ranking Engine Configuration
# ============================================

# --- Legacy v53e layer vars. Inert: parsed into config/settings.py RANKING_CONFIG,
# which nothing imports; v53e itself uses V53EConfig dataclass defaults. ---
# Layer 1: Time Window
RANKING_WINDOW_DAYS=365
INACTIVE_HIDE_DAYS=180

# Layer 2: Game Limits
MAX_GAMES_PER_TEAM=30
GOAL_DIFF_CAP=6
OUTLIER_GUARD_ZSCORE=2.5

# Layer 3: Recency Weighting
RECENT_K=15
RECENT_SHARE=0.65
DAMPEN_TAIL_START=26
DAMPEN_TAIL_END=30
DAMPEN_TAIL_START_WEIGHT=0.8
DAMPEN_TAIL_END_WEIGHT=0.4

# Layer 4: Defense Ridge
RIDGE_GA=0.25

# Layer 5: Adaptive K
ADAPTIVE_K_ALPHA=0.5
ADAPTIVE_K_BETA=0.6
TEAM_OUTLIER_GUARD_ZSCORE=2.5

# Layer 6: Performance
PERFORMANCE_K=0.15
PERFORMANCE_DECAY_RATE=0.08
PERFORMANCE_THRESHOLD=0.5
PERFORMANCE_GOAL_SCALE=5.0

# Layer 7: Bayesian Shrinkage
SHRINK_TAU=8.0

# Layer 8: Strength of Schedule
UNRANKED_SOS_BASE=0.35
SOS_REPEAT_CAP=2
SOS_ITERATIONS=1
SOS_TRANSITIVITY_LAMBDA=0.0

# Layer 10: Component Weights (must sum to 1.0)
OFF_WEIGHT=0.20
DEF_WEIGHT=0.20
SOS_WEIGHT=0.60

# Provisional Rankings
MIN_GAMES_FOR_RANKING=6

# Context Multipliers
TOURNAMENT_KO_MULT=1.10
SEMIS_FINALS_MULT=1.05

# Cross-Age Anchoring
ANCHOR_PERCENTILE=0.98

# Normalization
NORM_MODE=percentile

# ============================================
# Glicko-2 Engine Configuration (production; defaults shown,
# read by src/etl/glicko_config.py)
# =============================================================================
SCF_ENABLED=true
SCF_DIVERSITY_DIVISOR=4.0
SCF_FLOOR=0.4
SOS_CREDIT_CAP_ENABLED=false
RECORD_RECONCILE_ENABLED=false

# =============================================================================
# Machine Learning Layer Configuration
# ============================================
ML_LAYER_ENABLED=true
ML_ALPHA=0.08

ML_RECENCY_DECAY_LAMBDA=0.06
ML_MIN_TEAM_GAMES=12
ML_RESIDUAL_CLIP=3.5
ML_NORM_MODE=percentile
ML_LOOKBACK_DAYS=365

# XGBoost Parameters
ML_XGB_N_ESTIMATORS=220
ML_XGB_MAX_DEPTH=5
ML_XGB_LEARNING_RATE=0.08
ML_XGB_SUBSAMPLE=0.9
ML_XGB_COLSAMPLE_BYTREE=0.9
ML_XGB_REG_LAMBDA=1.0
ML_XGB_N_JOBS=-1

# Random Forest Parameters
ML_RF_N_ESTIMATORS=240
ML_RF_MAX_DEPTH=18
ML_RF_MIN_SAMPLES_LEAF=2
ML_RF_N_JOBS=-1

# ============================================
# System Configuration
# ============================================
LOG_LEVEL=INFO
USE_CACHE=true
PARALLEL_PROCESSING=true
DEBUG_MODE=false

# ============================================
# Web Scraping
# ============================================
# ZenRows API (for web scraping — used as GotSport API proxy)
ZENROWS_API_KEY=your-zenrows-api-key

# Serper.dev Google Search API (for Instagram handle discovery)
# Used by scripts/enrich_instagram_handles.py
# Get your key at https://serper.dev (free tier: 2,500 queries/month)
# Paid plans: ~$0.001/query — recommend starting with free tier to validate scoring
SERPER_API_KEY=your-serper-api-key

# ============================================
# Agent Tooling (Claude Code MCP)
# ============================================
# Not read from this file. Claude Code expands ${SUPABASE_ACCESS_TOKEN} in
# .mcp.json from the environment of the process that launched it. Generate it at
# https://supabase.com/dashboard/account/tokens and set it as a user environment
# variable WITHOUT putting the value on a command line (Windows: the Environment
# Variables dialog via `rundll32 sysdm.cpl,EditEnvironmentVariables`, or
# PowerShell `[Environment]::SetEnvironmentVariable('SUPABASE_ACCESS_TOKEN',
# (Read-Host 'PAT'), 'User')`), then restart whatever hosts Claude Code — the
# terminal or the editor. Type it yourself; never paste it into an agent session.
# A user variable reaches every process you launch; the profile of the shell
# that starts Claude Code is the narrower option.
#
# It is an account-wide Management API token: --read-only and --project-ref in
# .mcp.json limit the MCP server, not the token. If it ever lands in a log or a
# transcript, revoke it on that page. Left unset, the server refuses to start
# ("Please provide a personal access token") and the mcp__supabase__* tools are
# absent.
# SUPABASE_ACCESS_TOKEN=sbp_your_access_token_here

# ============================================
# Frontend Environment Variables (SEO & Analytics)
# ============================================
# The Next.js app does NOT read this file. Next loads env files from its own
# project root, so copy frontend/.env.example to frontend/.env.local for
# anything the frontend needs.
#
# NEXT_PUBLIC_SUPABASE_URL is listed here because Python scripts read it as a
# fallback for SUPABASE_URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Site URL - used for SEO metadata, sitemaps, and canonical URLs
NEXT_PUBLIC_SITE_URL=https://www.pitchrank.io

# Google Analytics 4 (GA4)
# Get your measurement ID from https://analytics.google.com
# Format: G-XXXXXXXXXX
# Leave empty to disable analytics in development
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta Pixel (Facebook/Instagram remarketing audiences)
# Get your pixel ID from https://business.facebook.com (Events Manager → Data Sources)
# Format: numeric pixel ID
# Leave empty to disable
NEXT_PUBLIC_META_PIXEL_ID=

# Google Ads remarketing tag
# Get your conversion ID from https://ads.google.com (Audiences/Tag)
# Format: AW-XXXXXXXXX
# Leave empty to disable
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=

# ============================================
# Email (Resend)
# ============================================
# Get your API key from https://resend.com/api-keys
# Used for both newsletter emails AND Supabase Auth SMTP (signup confirmation, password reset)
RESEND_API_KEY=re_your_api_key_here

# ============================================
# Stripe Payment Configuration
# ============================================
# Get your keys from https://dashboard.stripe.com/apikeys
# For production, use live keys (sk_live_, pk_live_)
# For development/testing, use test keys (sk_test_, pk_test_)

# Secret key (server-side only) - NEVER expose this to the client
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Publishable key (client-side)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Webhook signing secret
# Get this from Stripe Dashboard > Developers > Webhooks
# Create a webhook endpoint: https://yourdomain.com/api/stripe/webhook
# Events to listen for:
#   - checkout.session.completed
#   - customer.subscription.updated
#   - customer.subscription.deleted
#   - invoice.paid
#   - invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs for PitchRank Premium subscription plans
# Create these in Stripe Dashboard > Products
# Product: PitchRank Premium
#   - Monthly: $6.99/month recurring
#   - Yearly: $69.00/year recurring (17% savings)
STRIPE_PRICE_MONTHLY=price_your_monthly_price_id
STRIPE_PRICE_YEARLY=price_your_yearly_price_id

# Client-side price IDs (needed for checkout)
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=price_your_monthly_price_id
NEXT_PUBLIC_STRIPE_PRICE_YEARLY=price_your_yearly_price_id
