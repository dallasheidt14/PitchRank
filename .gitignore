# Exceeds GitHub's 100MB limit
psql/postgresql_16.exe

# data/ is pipeline scratch. The trailing /* is required: "data/" alone
# excludes the directory, so git cannot descend and the negations go dead.
# Fixtures fall back to skip when the generated dirs are absent.
data/*
!data/calibration/
!data/profiles/

# Ad-hoc CSV export that lands in the repo root
/teams.csv

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
env/
ENV/

# Node dependencies
node_modules/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Environment variables
.env
.env.local

# Test files
test_modular11_200.csv
credentials/

# Claude Code local settings (machine-specific permissions)
.claude/settings.local.json

# Playwright MCP page dumps (scratch output)
.playwright-mcp/
# Planning artifacts travel with the repo (a user-global ignore hides .turbo otherwise);
# everything else under .turbo/ stays local scratch.
!.turbo/
.turbo/*
!.turbo/plans/
!.turbo/shells/
!.turbo/specs/
!.turbo/handoff/
!.turbo/reports/
!.turbo/improvements.md
!.turbo/improvements-archive.md
# Customer PII and security-incident notes stay local:
.turbo/plans/auth-onboarding-lockout-fixes.md
.turbo/handoff/2026-08-20-team-matching-and-age-correctness.md
